# CHRGD Content Studio — environment configuration.
# Copy to `.env` and fill in. NEVER commit your real `.env`.

# --- Core (used from milestone 1) ---
# Where the SQLite backlog + run history lives.
CHRGD_DB_PATH=./data/chrgd.db
# Where generated assets are written.
CHRGD_OUTPUT_DIR=./output
# Prefix used when minting new idea_ids (e.g. G-0001).
CHRGD_ID_PREFIX=G

# --- LLM pipeline (milestone 2+) ---
OPENAI_API_KEY=
# Model that runs the 6-stage content pipeline. Any JSON-capable chat model.
# Cheap-but-capable default; swap for a smaller/newer model to cut cost.
CHRGD_OPENAI_MODEL=gpt-4o
# Optional: override the API base URL (aggregators / Azure / gateways).
OPENAI_BASE_URL=

# --- Image generation (milestone 3+) ---
# Background-per-slide image API. Defaults to OpenAI so one key covers both.
CHRGD_IMAGE_PROVIDER=openai
CHRGD_IMAGE_MODEL=gpt-image-2
# Per-slide quality is set in brand.toml (slide 1 high, rest medium).
# Leave blank to reuse OPENAI_API_KEY; set only for a separate image provider.
CHRGD_IMAGE_API_KEY=

# --- Video generation (milestone 6 — infra present, feature OFF) ---
# Master switch. Leave false: the plumbing is in place but no paid video calls
# happen until this is true and the M6 assembly pipeline is built.
CHRGD_VIDEO_ENABLED=false
CHRGD_VIDEO_PROVIDER=higgsfield
# Higgsfield Cloud API key (or an aggregator key, e.g. Segmind).
HIGGSFIELD_API_KEY=
# Base-URL override to swap providers (e.g. a Segmind endpoint).
CHRGD_HIGGSFIELD_BASE_URL=https://platform.higgsfield.ai
# "draft" (visuals only, add trending sound in-app) or "auto" (neutral bed).
CHRGD_AUDIO_MODE=draft

# --- Cost guard ---
# Hard per-run spend cap (USD). A run aborts before exceeding this.
CHRGD_MAX_SPEND_PER_RUN=5.0

# --- Web dashboard (Phase A) ---
CHRGD_WEB_USERNAME=admin
# Preferred: a pbkdf2 hash from `python -m chrgd.webauth <password>`.
CHRGD_WEB_PASSWORD_HASH=
# Or a plaintext password (simpler, fine for a private single-user box).
CHRGD_WEB_PASSWORD=
# Signs session cookies — set a long random value so logins survive restarts.
CHRGD_SECRET_KEY=

# --- Optional posting backends (milestone 7) ---
# Unified social API (Postpeer/Ayrshare style) — behind a flag.
CHRGD_UNIFIED_API_KEY=
